# Variables de entorno para Docker Compose.
# Copia este fichero a `.env` en la raiz del proyecto y rellena los valores.
# Nunca commitees un fichero `.env` con credenciales reales (.env esta en .gitignore).

# Base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-in-production
POSTGRES_DB=hospital_pro
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend - variables obligatorias para Compose (sin fallback inseguro, F1-05).
# Generar SECRET_KEY de forma segura:
#   openssl rand -hex 32
SECRET_KEY=tu-secret-key-aqui-cambiar-en-produccion
STAFF_PASSWORD=tu-staff-password-aqui-cambiar-en-produccion
