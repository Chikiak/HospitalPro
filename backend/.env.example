# Variables de entorno del backend.
# Copia este fichero a `.env` y rellena los valores antes de ejecutar la app.
# Nunca commitees un fichero `.env` con credenciales reales (.env esta en .gitignore).

# Base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-in-production
POSTGRES_DB=hospital_pro
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Seguridad - OBLIGATORIOS, sin valor por defecto (F1-05).
# Generar SECRET_KEY de forma segura:
#   openssl rand -hex 32
SECRET_KEY=tu-secret-key-aqui-cambiar-en-produccion
ADMIN_PASSWORD=tu-admin-password-aqui-cambiar-en-produccion
STAFF_PASSWORD=tu-staff-password-aqui-cambiar-en-produccion

# Runtime
SQL_ECHO=false
ALLOWED_ORIGINS=http://localhost:5173

# Seguridad adicional
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1
